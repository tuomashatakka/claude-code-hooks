{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "description": "Enhanced hooks for Claude Code (TypeScript + Bun)",
  "hooks": {
    "PreToolUse": [
      { "hooks": [
        { "type": "command", "command": "bun run ${CLAUDE_PLUGIN_ROOT}/hooks/bin/bind.ts PreToolUse" }
      ]}
    ],
    "PostToolUse": [
      { "hooks": [
        { "type": "command", "command": "bun run ${CLAUDE_PLUGIN_ROOT}/hooks/bin/bind.ts PostToolUse" }
      ]}
    ],
    "PostToolUseFailure": [
      { "hooks": [
        { "type": "command", "command": "bun run ${CLAUDE_PLUGIN_ROOT}/hooks/bin/bind.ts PostToolUseFailure" }
      ]}
    ],
    "PostToolBatch": [
      { "hooks": [
        { "type": "command", "command": "bun run ${CLAUDE_PLUGIN_ROOT}/hooks/bin/bind.ts PostToolBatch" }
      ]}
    ],

    "SessionStart": [
      { "hooks": [
        { "type": "command", "command": "bun run ${CLAUDE_PLUGIN_ROOT}/hooks/bin/bind.ts SessionStart" }
      ]}
    ],
    "SessionEnd": [
      { "hooks": [
        { "type": "command", "command": "bun run ${CLAUDE_PLUGIN_ROOT}/hooks/bin/bind.ts SessionEnd" }
      ]}
    ],

    "PostCompact": [
      { "hooks": [
        { "type": "command", "command": "bun run ${CLAUDE_PLUGIN_ROOT}/hooks/bin/bind.ts PostCompact" }
      ]}
    ],

    "InstructionsLoaded": [
      { "hooks": [
        { "type": "command", "command": "bun run ${CLAUDE_PLUGIN_ROOT}/hooks/bin/bind.ts InstructionsLoaded" }
      ]}
    ],

    "UserPromptSubmit": [
      { "hooks": [
        { "type": "command", "command": "bun run ${CLAUDE_PLUGIN_ROOT}/hooks/bin/bind.ts UserPromptSubmit" }
      ]}
    ],
    "UserPromptExpansion": [
      { "hooks": [
        { "type": "command", "command": "bun run ${CLAUDE_PLUGIN_ROOT}/hooks/bin/bind.ts UserPromptExpansion" }
      ]}
    ],

    "SubagentStart": [
      { "hooks": [
        { "type": "command", "command": "bun run ${CLAUDE_PLUGIN_ROOT}/hooks/bin/bind.ts SubagentStart" }
      ]}
    ],
    "SubagentStop": [
      { "hooks": [
        { "type": "command", "command": "bun run ${CLAUDE_PLUGIN_ROOT}/hooks/bin/bind.ts SubagentStop" }
      ]}
    ],
    "Stop": [
      { "hooks": [
        { "type": "command", "command": "bun run ${CLAUDE_PLUGIN_ROOT}/hooks/bin/bind.ts Stop" }
      ]}
    ]
  }
}

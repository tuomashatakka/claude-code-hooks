{
  "name": "claude-hooks",
  "version": "2.2.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "smoke": "bun run scripts/smoke.ts",
    "demo:capture": "bun run scripts/capture-demo.ts",
    "build": "esbuild hooks/bin/bind.ts --bundle --platform=node --format=esm --target=node18 --outfile=dist/hooks.mjs --banner:js=\"import{createRequire as __ccr}from'node:module';const require=__ccr(import.meta.url);\"",
    "dev:refresh": "bun run scripts/dev-refresh.ts",
    "image:baseline": "bun run scripts/image-baseline.ts",
    "preview": "bun run scripts/preview.ts"
  },
  "dependencies": {
    "@tuomashatakka/ansi-headings": "workspace:*",
    "@tuomashatakka/image-to-ascii": "workspace:*",
    "chalk": "^5.6.2",
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@types/pngjs": "^6.0.5",
    "bun-types": "latest",
    "typescript": "^5.6.0",
    "esbuild": "0.28.1"
  }
}
